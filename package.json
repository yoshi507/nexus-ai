{
  "name": "nexus-ai",
  "version": "1.0.2",
  "description": "A desktop AI website hub for accessing multiple AI providers",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run compile && electron .",
    "dev": "npm start",
    "compile": "tsc && node scripts/copy-renderer.js",
    "build": "npm run compile && electron-builder --linux AppImage",
    "test": "npm run compile && node --test"
  },
  "keywords": [
    "electron",
    "ai",
    "browser",
    "desktop",
    "providers"
  ],
  "author": "Nexus AI",
  "license": "MIT",
  "desktopName": "nexus-ai",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.9.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "com.nexusai.app",
    "productName": "Nexus AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    }
  }
}
